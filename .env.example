# ── AI PROVIDER — pick ONE ────────────────────────────────
# Option 1: Groq — FREE, no credit card → console.groq.com
GROQ_API_KEY=your_groq_key_here

# Option 2: Google Gemini — FREE, 1500/day → aistudio.google.com
# GEMINI_API_KEY=your_gemini_key_here

# Option 3: Anthropic — $5 free credit → console.anthropic.com
# ANTHROPIC_API_KEY=your_key_here

# Option 4: OpenAI — needs credit card → platform.openai.com
# OPENAI_API_KEY=your_key_here

# ── EMBEDDINGS ────────────────────────────────────────────
# If GEMINI_API_KEY set   → uses Gemini embeddings (free)
# If OPENAI_API_KEY set   → uses text-embedding-3-small
# Neither set             → uses local sentence-transformers (free, ~90MB)

# ── RAG SETTINGS (optional) ───────────────────────────────
INITIAL_TOP_K=20
FINAL_TOP_K=4

# ── TELEGRAM BOT (optional) ───────────────────────────────
# 1. Message @BotFather → /newbot → copy token
# TELEGRAM_BOT_TOKEN=your_token_here
# API_BASE_URL=http://localhost:8000
